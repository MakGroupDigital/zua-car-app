rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Règles permissives TEMPORAIRES pour développement.
    // Tout utilisateur connecté peut lire et écrire toutes les collections.
    // Les utilisateurs non connectés n'ont aucun accès.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
